@startuml transition-phases
title Arquitetura de Transição

skinparam shadowing false
left to right direction

rectangle "Fase 0\nMonolito\nBoot 2.4 / Java 17" as F0
rectangle "Fase 1\nMulti-módulo Maven\nextrai shared-kernel" as F1
rectangle "Fase 2\nSepara 2 deployables\nmesmo broker e DB" as F2
rectangle "Fase 3\nEvent-carried state\nremove leitura cruzada" as F3
rectangle "Fase 4\nUpgrade Boot 3 / Java 21\n+ observabilidade + segurança" as F4
rectangle "Alvo futuro\nDB por serviço\nCI/CD + escala horizontal" as F5 #FFF4E5

F0 --> F1
F1 --> F2
F2 --> F3
F3 --> F4
F4 --> F5

@enduml
