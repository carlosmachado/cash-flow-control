# Host port overrides for docker-compose (container ports are unchanged).
# Defaults in docker-compose.yml are the standard ports; these avoid clashes
# when 5432/5672/8080/8081 are already in use on the host.
POSTGRES_PORT=55432
RABBITMQ_PORT=55672
RABBITMQ_MGMT_PORT=15673
TRANSACTION_PORT=18080
CONSOLIDATION_PORT=18081
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
